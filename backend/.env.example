# Copiá este archivo como .env y completá los valores. El .env nunca se sube a GitHub.

PORT=4000

# URI de conexión de MongoDB Atlas (Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://TU_USUARIO:TU_PASSWORD@TU_CLUSTER.mongodb.net/inmobiliaria_db?retryWrites=true&w=majority

# Clave para firmar las sesiones. En desarrollo es opcional; en producción es obligatoria (32 caracteres o más).
# Para generar una: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Orígenes que pueden usar la API, separados por coma. Vacío en desarrollo = se acepta cualquiera.
CORS_ORIGIN=

# Fotos de las propiedades en Cloudinary (obligatorio en producción). Vacío = se guardan en backend/uploads.
CLOUDINARY_URL=
