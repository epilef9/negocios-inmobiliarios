# Copiá este archivo como .env y completá los valores. El .env nunca se sube a GitHub.

PORT=4000

# URI de conexión de MongoDB Atlas (Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://TU_USUARIO:TU_PASSWORD@TU_CLUSTER.mongodb.net/inmobiliaria_db?retryWrites=true&w=majority

# Clave para firmar las sesiones. En desarrollo es opcional; en producción es obligatoria (32 caracteres o más).
# Para generar una: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Clave privada para cifrar documentos y datos personales de las solicitudes (AES-256-GCM).
# Generala con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SOLICITUDES_ENCRYPTION_KEY=

# Orígenes que pueden usar la API, separados por coma. Vacío en desarrollo = se acepta cualquiera.
CORS_ORIGIN=

# Fotos de las propiedades en Cloudinary (obligatorio en producción). Vacío = se guardan en backend/uploads.
CLOUDINARY_URL=

# Mails (verificación de cuenta y formulario de contacto). Elegí UNA de las dos opciones, las dos son gratis.
# Sin ninguna, en desarrollo los mails se muestran en la consola del backend en lugar de enviarse.
# A) Brevo por API (300 mails/día, funciona en Render gratis): brevo.com → SMTP y API → API keys.
#    El remitente (MAIL_FROM) tiene que estar verificado en Brevo → Remitentes.
BREVO_API_KEY=
# B) SMTP, por ejemplo Gmail con una contraseña de aplicación (smtp.gmail.com, puerto 587).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remitente de los mails, por ejemplo: Negocios Inmobiliarios <tucuenta@gmail.com>
MAIL_FROM=
# Correo que recibe las consultas del formulario de contacto (si falta, usa MAIL_FROM)
CONTACT_TO=
# Dirección pública del sitio, para armar el enlace de verificación (si falta, usa la primera de FRONTEND_URLS)
FRONTEND_URL=
